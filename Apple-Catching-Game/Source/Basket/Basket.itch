number speed;


event event_whenbroadcastreceived(@message("start")) {
    motion_gotoxy(0, MIN_Y + 50); // start position. centre of the screen and slightly above the bottom.
    speed = 10;
    forever {
        if sensing_keypressed("a") {
            motion_changexby(-speed);
        }
        if sensing_keypressed("d") {
            motion_changexby(speed);
        }
    }
}


event event_whenbroadcastreceived(@message("game over")) {
    looks_say(operator_join(operator_join("Game over!", " Your score is: "), score));
    control_stop("other scripts in sprite");
    gameRunning = false;
}